{
  "name": "@teyaproduct/teya-blocks-js",
  "version": "0.0.1",
  "description": "Lightweight loader for Teya Blocks SDK",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "browser": "dist/teya-blocks-js.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "npm run build && changeset publish",
    "release": "npm run build && changeset publish"
  },
  "keywords": [
    "teya",
    "payments",
    "sdk",
    "checkout",
    "loader"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/saltpay/teya-blocks-js"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^9.19.0",
    "eslint": "^10.0.2",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.56.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
